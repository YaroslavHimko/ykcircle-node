# Local development template only. Do not put staging or production values here.
# Deployment: inject real values as runtime environment variables in the pipeline.
# npm start does not load this file. To use local values explicitly:
# node --env-file=.env server/index.js
# Set a separate random AUTH_SECRET and local service credentials before starting.
NODE_ENV=development
SMTP_DIAGNOSTICS=false
DOMAIN=localhost
SITE_URL=http://localhost:5173
API_URL=http://localhost:3001
BRAND_NAME=YKCircle
AUTH_SECRET=

# Local database
DB_HOST=127.0.0.1
DB_NAME=ykcircle_local
DB_USER=
DB_PASSWORD=
DB_PORT=3306

# Local SMTP capture service; credentials are optional if the service permits it.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REPLY_TO=support@localhost
NO_REPLY_FROM=notifications@localhost
APPLICATION_NOTIFICATION_FROM=notifications@localhost
INVITATION_FROM=notifications@localhost

# Remote uploads are unconfigured locally. Set credentials only for local test services.
FTP_PROFILE_HOST=
FTP_PROFILE_USERNAME=
FTP_PROFILE_PASSWORD=
FTP_PROFILE_UPLOAD_PATH=/profile-pictures
FTP_PROFILE_PUBLIC_URL=http://localhost:3001/uploads/profile-pictures
FTP_PROFILE_SECURE=false
FTP_PROFILE_TIMEOUT_MS=30000
FTP_PROFILE_TLS_SERVERNAME=

FTP_EVENT_HOST=
FTP_EVENT_USERNAME=
FTP_EVENT_PASSWORD=
FTP_EVENT_UPLOAD_PATH=/event-covers
FTP_EVENT_PUBLIC_URL=http://localhost:3001/uploads/event-covers
FTP_EVENT_SECURE=false
FTP_EVENT_TLS_SERVERNAME=

FTP_GROUP_HOST=
FTP_GROUP_USERNAME=
FTP_GROUP_PASSWORD=
FTP_GROUP_UPLOAD_PATH=/group-covers
FTP_GROUP_PUBLIC_URL=http://localhost:3001/uploads/group-covers
FTP_GROUP_SECURE=false
FTP_GROUP_TLS_SERVERNAME=

FTP_ARTICLE_HOST=
FTP_ARTICLE_USERNAME=
FTP_ARTICLE_PASSWORD=
FTP_ARTICLE_UPLOAD_PATH=/article-images
FTP_ARTICLE_PUBLIC_URL=http://localhost:3001/uploads/article-images
FTP_ARTICLE_SECURE=false
FTP_ARTICLE_TLS_SERVERNAME=

FTP_VENUE_HOST=
FTP_VENUE_USERNAME=
FTP_VENUE_PASSWORD=
FTP_VENUE_UPLOAD_PATH=/venue-images
FTP_VENUE_PUBLIC_URL=http://localhost:3001/uploads/venue-images
FTP_VENUE_SECURE=false
FTP_VENUE_TLS_SERVERNAME=

# Deployment operator details belong in pipeline variables.
PLATFORM_OPERATOR_NAME=
PLATFORM_OPERATOR_EMAIL=support@localhost
PLATFORM_REGISTERED_ADDRESS=
PLATFORM_COUNTRY=
PLATFORM_ORGANISATION_NUMBER=
PLATFORM_VAT_NUMBER=
PRIVACY_EMAIL=privacy@localhost
SUPPORT_EMAIL=support@localhost
MODERATION_EMAIL=moderation@localhost
BILLING_SUPPORT_EMAIL=billing@localhost
TICKET_SUPPORT_EMAIL=support@localhost
VENUE_SUPPORT_EMAIL=support@localhost

GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_REQUIRES_CONSENT=true
ENABLE_PAID_EVENTS=false
ENABLE_PAID_SERVICES=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_PRIVACY_URL=
PAYMENT_DIRECT_CHARGE_VERIFIED=false
MINIMUM_USER_AGE=18
ANALYTICS_PROVIDERS=None
MARKETING_PROVIDERS=None
COOKIE_INVENTORY=No optional technologies configured in development
SUBPROCESSORS_JSON=[]
LEGAL_REQUIRE_READY=false
